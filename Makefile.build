.PHONY: build clean verify
BUILD_DIR := evidence
SENTINEL  := $(BUILD_DIR)/.built
SHA_CMD   := $(shell command -v sha256sum 2>/dev/null || command -v shasum)

build:
	@test -z "$$(git status --porcelain)" || { echo "FAIL: dirty tree — commit or stash first"; exit 1; }
	@rm -rf $(BUILD_DIR)
	@mkdir -p $(BUILD_DIR)/source $(BUILD_DIR)/records $(BUILD_DIR)/records/models
	@git ls-files -z | ( tr '\0' '\n' | grep -v '^evidence/' | tr '\n' '\0' ) | while IFS= read -r -d '' f; do \
	  mkdir -p "$(BUILD_DIR)/source/$$(dirname "$$f")"; \
	  cp "$$f" "$(BUILD_DIR)/source/$$f"; \
	done
	@cp apex/*.json $(BUILD_DIR)/records/ 2>/dev/null || true
	@cp apex/models/*.json $(BUILD_DIR)/records/models/ 2>/dev/null || true
	@find $(BUILD_DIR) -type f ! -name MANIFEST.sha256 ! -name .built -print0 \
	  | xargs -0 $(SHA_CMD) -a 256 | sort -k2 > $(BUILD_DIR)/MANIFEST.sha256
	@date -u +%FT%TZ > $(SENTINEL)
	@echo "built: $$(wc -l < $(BUILD_DIR)/MANIFEST.sha256 | tr -d ' ') files"

clean:
	@rm -rf $(BUILD_DIR)

verify:
	@test -f $(SENTINEL) || { echo "FAIL: not built"; exit 1; }
	@$(SHA_CMD) -a 256 -c $(BUILD_DIR)/MANIFEST.sha256 --quiet \
	  && echo "OK: $$(wc -l < $(BUILD_DIR)/MANIFEST.sha256 | tr -d ' ') files verified"
