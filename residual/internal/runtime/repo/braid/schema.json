{
  "name": "COGNITIVE_DSL_V1",
  "version": "1.0",
  "types": {
    "SymbolID": "string",
    "IntentID": "string",
    "EntityID": "string",
    "OperatorID": "string",
    "ContextID": "string",
    "Vector": "float[]",
    "Probability": "float[0,1]",
    "Timestamp": "int64",
    "AttributeMap": "map<string,any>",
    "ConstraintMap": "map<string,any>",
    "StateMap": "map<string,any>"
  },
  "structs": {
    "Symbol": {
      "id": "SymbolID",
      "embedding": "Vector",
      "expands_to": "Expansion",
      "aliases": "SymbolID[]"
    },
    "Expansion": {
      "operators": "OperatorID[]",
      "constraints": "ConstraintMap",
      "default_params": "AttributeMap"
    },
    "Intent": {
      "id": "IntentID",
      "raw_input": "string",
      "symbols": "SymbolID[]",
      "context": "ContextID",
      "priority": "int"
    },
    "Context": {
      "id": "ContextID",
      "entities": "EntityID[]",
      "environment": "StateMap",
      "history": "Event[]"
    },
    "Event": {
      "ts": "Timestamp",
      "type": "string",
      "payload": "AttributeMap"
    },
    "Entity": {
      "id": "EntityID",
      "class": "string",
      "attributes": "AttributeMap",
      "state": "StateMap",
      "belief": "Probability",
      "last_seen": "Timestamp"
    },
    "Track": {
      "entity_id": "EntityID",
      "observations": "Observation[]",
      "continuity_score": "Probability"
    },
    "Observation": {
      "ts": "Timestamp",
      "features": "Vector",
      "source": "string"
    },
    "Operator": {
      "id": "OperatorID",
      "input_schema": "AttributeMap",
      "output_schema": "AttributeMap",
      "preconditions": "ConstraintMap",
      "effects": "StateMap"
    },
    "ExecNode": {
      "id": "string",
      "operator": "OperatorID",
      "inputs": "AttributeMap",
      "outputs": "AttributeMap",
      "status": "PENDING|RUNNING|DONE|FAILED"
    },
    "ExecEdge": {
      "from": "string",
      "to": "string",
      "condition": "ConstraintMap"
    },
    "ExecGraph": {
      "nodes": "ExecNode[]",
      "edges": "ExecEdge[]"
    }
  },
  "functions": [
    "COMPILE(intent) -> ExecGraph",
    "RESOLVE_SYMBOLS(symbol_ids) -> Symbol[]",
    "BUILD_GRAPH(operators) -> ExecGraph",
    "AUTO_LINK(nodes) -> ExecEdge[]",
    "EXECUTE(graph, context) -> updated graph",
    "UPDATE_TRACK(track, obs)",
    "ESTIMATE_CONTINUITY(observations) -> Probability"
  ],
  "invariants": [
    "∀ symbol → deterministic expansion",
    "∀ intent → finite ExecGraph",
    "∀ entity → probabilistic continuity tracked",
    "context updated after each node execution"
  ],
  "api": [
    "REGISTER_SYMBOL",
    "REGISTER_OPERATOR",
    "INGEST_INTENT",
    "RUN",
    "UPDATE_OBSERVATION"
  ],
  "hooks": [
    "SYMBOL_RESOLVER",
    "GRAPH_OPTIMIZER",
    "TRACKING_MODEL",
    "OPERATOR_BACKENDS"
  ],
