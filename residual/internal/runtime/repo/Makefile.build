.PHONY: build clean verify
BUILD_DIR := evidence
SENTINEL  := $(BUILD_DIR)/.built

build:
	@test -n "$$CI" || test -z "$$(git status --porcelain)" || { echo "FAIL: dirty tree"; exit 1; }
	@rm -rf $(BUILD_DIR)
	@mkdir -p $(BUILD_DIR)/source $(BUILD_DIR)/records $(BUILD_DIR)/records/models
	@git ls-files -z | ( tr '\0' '\n' | grep -v '^evidence/' | tr '\n' '\0' ) | while IFS= read -r -d '' f; do \
	  mkdir -p "$(BUILD_DIR)/source/$$(dirname "$$f")"; \
	  cp "$$f" "$(BUILD_DIR)/source/$$f"; \
	done
	@cp apex/*.json $(BUILD_DIR)/records/ 2>/dev/null || true
	@cp apex/models/*.json $(BUILD_DIR)/records/models/ 2>/dev/null || true
	@cd $(BUILD_DIR) && find . -type f ! -name MANIFEST.sha256 ! -name .built -print0 \
	  | xargs -0 shasum -a 256 2>/dev/null \
	  | sort -k2 > MANIFEST.sha256 || \
	  ( find . -type f ! -name MANIFEST.sha256 ! -name .built -print0 \
	    | xargs -0 sha256sum | sed 's|  \./|  |' | sort -k2 > MANIFEST.sha256 )
	@date -u +%FT%TZ > $(SENTINEL)
	@echo "built: $$(wc -l < $(BUILD_DIR)/MANIFEST.sha256 | tr -d ' ') files"

clean:
	@rm -rf $(BUILD_DIR)

verify:
	@test -f $(SENTINEL) || { echo "FAIL: not built"; exit 1; }
	@cd $(BUILD_DIR) && { shasum -a 256 -c MANIFEST.sha256 --quiet 2>/dev/null || sha256sum -c MANIFEST.sha256 --quiet; } \
	  && echo "OK: $$(wc -l < MANIFEST.sha256 | tr -d ' ') files verified"
