{
  "schema": "ship/v1",
  "artifact": "residual-compiler-<sha>.tgz",
  "contents": [
    "source/  (every git-tracked file, hashed)",
    "records/ (every apex/*.json at build time)",
    "MANIFEST.sha256",
    "SHIP.json",
    "README.md"
  ],
  "verification": [
    "sha256sum -c MANIFEST.sha256",
    "python3 -m pytest -q (must be 43 passed)",
    "python3 scripts/control_plane.py (must print COVERED)",
    "python3 scripts/org.py (must print COVERED)"
  ],
  "gate": "no push if verify fails"
}
