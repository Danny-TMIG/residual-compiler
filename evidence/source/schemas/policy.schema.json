{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Policy",
  "type": "object",
  "required": ["rules", "default"],
  "properties": {
    "version": {"type": "integer"},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "then"],
        "properties": {
          "id": {"type": "string"},
          "when": {"type": "object"},
          "then": {"enum": ["ALLOW","DENY","ESCALATE"]},
          "reason": {"type": "string"},
          "requires": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "default": {"enum": ["ALLOW","DENY"]},
    "sha256": {"type": "string"}
  }
}
