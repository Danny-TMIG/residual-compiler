{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillContract",
  "type": "object",
  "required": ["identifier", "result_states"],
  "properties": {
    "identifier": {"type": "string", "minLength": 1},
    "version": {"type": "string"},
    "description": {"type": "string"},
    "capability": {"type": "string"},
    "domain": {"type": "string"},
    "operation": {"type": "string"},
    "input_types": {"type": "object", "additionalProperties": {"enum": ["string","int","list[string]","json","obj","path"]}},
    "output_types": {"type": "object"},
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "postconditions": {"type": "array", "items": {"type": "string"}},
    "permissions": {"type": "array", "items": {"type": "string"}},
    "retries": {"type": "object"},
    "rollback": {"type": "string"},
    "evidence_produced": {"type": "array", "items": {"type": "string"}},
    "result_states": {"type": "array", "items": {"type": "string"}},
    "impl": {"type": "string"}
  }
}
