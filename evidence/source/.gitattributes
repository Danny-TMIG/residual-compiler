# Force LF in the working tree on every OS.
# Without this, Windows checkout converts LF to CRLF and file SHAs diverge.
* text=auto eol=lf
*.py text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.sha256 text eol=lf
*.sql text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
