#!/usr/bin/env bash
# Print per-stage doc/token counts + gate verdict.
set -euo pipefail
HERE="$(cd "$(dirname "$0")/.." && pwd)"
for f in ingest clean dedup tokenize split; do
  [ -f "$HERE/artifacts/$f.json" ] || continue
  python -c "
import json
d=json.load(open('$HERE/artifacts/$f.json'))
print('$f: docs=',len(d.get('documents',[])),
      'count=',d.get('count'),
      'total_tokens=',d.get('total_tokens'))
"
done
[ -f "$HERE/artifacts/gate_runner.json" ] && python -c "
import json
d=json.load(open('$HERE/artifacts/gate_runner.json'))['decision_record']
print('verdict:', d['final_verdict'])
for g in d['gates']: print(' ', g['gate'], g['passed'], g.get('kill_reasons'))
"
