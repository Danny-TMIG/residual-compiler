#!/usr/bin/env bash
# Materialize a training JSONL from a dedup (or ingest) artifact.
set -euo pipefail
HERE="$(cd "$(dirname "$0")/.." && pwd)"
ART="${1:-$HERE/artifacts/dedup.json}"
OUT="${2:-$HERE/data/processed/real_train.jsonl}"
python - "$ART" "$OUT" <<'PY'
import json, sys
art, out = sys.argv[1], sys.argv[2]
d = json.load(open(art))
docs = d.get("documents", [])
with open(out, "w", encoding="utf-8") as f:
    for doc in docs:
        f.write(json.dumps({"text": doc["text"]}, ensure_ascii=False) + "\n")
print(f"wrote {len(docs)} records -> {out}")
PY
